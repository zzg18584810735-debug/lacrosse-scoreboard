# ============================================
# 运行环境切换（dev / test / prod）
# 仅需修改该变量即可切换 yml 中的环境配置
# ============================================
SPRING_PROFILES_ACTIVE=prod

# ============================================
# 数据库连接配置（仅连接信息放在此处）
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=edus_prod
DB_USERNAME=root
DB_PASSWORD=change-me-db-password

# ============================================
# Redis 连接配置（仅连接信息放在此处）
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=9
