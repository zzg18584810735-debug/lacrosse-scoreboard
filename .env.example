# Server config
SERVER_PORT=8080
SERVER_CONTEXT_PATH=/api
SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-XX:InitialRAMPercentage=50 -XX:MaxRAMPercentage=75 -Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8

# Database config
DB_HOST=localhost
DB_PORT=3306
DB_NAME=edus_prod
DB_USERNAME=root
DB_PASSWORD=change-me-db-password

# Redis config
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=9

# Signature config
EDUS_SIGN_ENABLED=true
EDUS_SIGN_APP_ID=edus-prod-open-api
EDUS_SIGN_SECRET=change-me-prod-sign-secret
EDUS_SIGN_EXPIRE_SECONDS=300

# Async config
EDUS_ASYNC_TIMEOUT_WARNING_MILLIS=30000

# Monitor config
EDUS_MONITOR_ACCESS_TOKEN=change-me-monitor-token
EDUS_MONITOR_ALLOW_INTERNAL_NETWORK=true
