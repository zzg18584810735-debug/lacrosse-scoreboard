# Copy this file to .env.<environment> and fill the non-example values.
# Docker: docker run --env-file .env.prod ...
# Plain java -jar does not load .env files; export these variables in the shell or service unit.
# Select one of: dev, test, prod.
SPRING_PROFILES_ACTIVE=test

# ============================================
# 数据库连接配置（仅连接信息放在此处）
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hello
DB_USERNAME=root
DB_PASSWORD=

# ============================================
# Redis 连接配置（仅连接信息放在此处）
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=9

# Signing and monitor tokens are configured in application-<profile>.yml.
