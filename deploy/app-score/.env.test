# 测试环境后端配置。服务器使用其他地址时，上传后直接修改本文件。
SPRING_PROFILES_ACTIVE=test
SERVER_PORT=8080
TZ=Asia/Shanghai
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC -Dfile.encoding=UTF-8
LOG_PATH=/app/logs

# Docker 容器访问宿主机上的 MySQL。
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=hello
DB_USERNAME=root
DB_PASSWORD=请填写数据库密码
DB_USE_SSL=false
DB_TIMEZONE=UTC

# Docker 容器访问宿主机上的 Redis。
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
